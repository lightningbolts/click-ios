<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Event pictures the app saves for the Live Activity (an extension can't download them). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.compose.project.click.click</string>
	</array>
</dict>
</plist>
